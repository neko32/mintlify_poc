{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "catcafe",
  "description": "猫カフェのデータに自然言語で質問できる、セマンティックデータ基盤の POC のドキュメントです。",
  "colors": {
    "primary": "#B45309",
    "light": "#FBBF24",
    "dark": "#92400E"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Noto Sans JP",
    "heading": {
      "family": "Zen Maru Gothic",
      "weight": 700
    }
  },
  "banner": {
    "content": "catcafe は検証用の POC です。実装範囲は[現状とロードマップ](/project/status)を確認してください。",
    "dismissible": true
  },
  "navigation": {
    "languages": [
      {
        "language": "jp",
        "tabs": [
          {
            "tab": "ドキュメント",
            "icon": "book-open",
            "groups": [
              {
                "group": "はじめに",
                "pages": [
                  "index",
                  "quickstart"
                ]
              },
              {
                "group": "コンセプト",
                "pages": [
                  "concepts/architecture",
                  "concepts/domain-model",
                  "concepts/semantic-layer",
                  "concepts/nl-query"
                ]
              }
            ]
          },
          {
            "tab": "ガイド",
            "icon": "compass",
            "groups": [
              {
                "group": "使う",
                "pages": [
                  "guides/streamlit",
                  "guides/mcp-claude-desktop",
                  "guides/sparql-recipes"
                ]
              },
              {
                "group": "準備と拡張",
                "pages": [
                  "guides/demo-data",
                  "guides/custom-llm"
                ]
              },
              {
                "group": "困ったときは",
                "pages": [
                  "guides/troubleshooting"
                ]
              }
            ]
          },
          {
            "tab": "リファレンス",
            "icon": "code",
            "groups": [
              {
                "group": "Python API",
                "pages": [
                  "reference/nl-query",
                  "reference/fuseki-client",
                  "reference/repositories"
                ]
              },
              {
                "group": "データ",
                "pages": [
                  "reference/entities",
                  "reference/ontology"
                ]
              },
              {
                "group": "ツールと設定",
                "pages": [
                  "reference/scripts",
                  "reference/configuration"
                ]
              }
            ]
          },
          {
            "tab": "プロジェクト",
            "icon": "folder-open",
            "groups": [
              {
                "group": "プロジェクト",
                "pages": [
                  "project/status",
                  "project/security",
                  "project/changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/neko32/catcafe"
    }
  },
  "search": {
    "prompt": "ドキュメントを検索"
  },
  "markdown": {
    "instructions": "catcafe is a proof of concept with no customer-facing reservation site yet. Do not describe SSO login or the reservation and purchase pages as implemented; see /project/status. SPARQL is generated by a local LLM through NLQueryService, and only SELECT queries pass validation."
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "ページが見つかりません",
      "description": "[トップページ](/)または検索から探してください。"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/neko32/catcafe"
    }
  }
}
